{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    <% if (props.flags.importAlias) { %>
    "strict": true,
    "baseUrl": ".",
      "paths": {
        <% if (typeof props.flags.importAlias === 'string') { %>
          "<%= props.flags.importAlias %>": ["./*"]
        <% } else { %>
          "@/*": ["./*"]
        <% } %>
    }
    <% } else { %>
      "strict": true
    <% } %>
  <% if (props.navigationPackage?.name === 'expo-router') { %>
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    <% if (props.stylingPackage?.name === 'nativewind' || props.stylingPackage?.name === 'nativewindui') { %>
      "expo-env.d.ts",
      "nativewind-env.d.ts"
    <% } else { %>
      "expo-env.d.ts"
    <% } %>
  ]
  <% } else { %>
    }
  <% } %>
}
