<% if (props.stylingPackage?.name === "nativewind") { %>
import '../global.css';
import { SafeAreaProvider } from 'react-native-safe-area-context';
<% } %>

<% if (props.stylingPackage?.name === "unistyles") { %>
import { useUnistyles } from 'react-native-unistyles';
<% } %>
<% if (props.internalizationPackage?.name === "i18next") { %>
import '../translation';
<% } %>
import { Stack } from 'expo-router';

<% if (props.analyticsPackage?.name === "vexo-analytics") { %>
import { vexo } from 'vexo-analytics';

vexo(process.env.EXPO_PUBLIC_VEXO_API_KEY);
<% } %>

<% if (props.sentryPackage?.name === "sentry") { %>
import '@/utils/sentry';
<% } %>

export default function Layout() {
<% if (props.stylingPackage?.name === "unistyles") { %>
  const { theme } = useUnistyles();
<% } %>

  return (
<% if (props.stylingPackage?.name === "unistyles") { %>
    <Stack
      screenOptions={{
        headerStyle: {
          backgroundColor: theme.colors.background,
        },
        headerTitleStyle: {
          color: theme.colors.typography,
        },
        headerTintColor: theme.colors.typography,
      }}
    >
      <% if (props.stylingPackage?.options?.pagePresets?.includes('settings')) { %>
      <Stack.Screen name="settings" options={{ title: 'Settings' }} />
      <% } %>
      <% if (props.stylingPackage?.options?.pagePresets?.includes('profile')) { %>
      <Stack.Screen name="profile" options={{ title: 'Profile' }} />
      <% } %>
      <% if (props.stylingPackage?.options?.pagePresets?.includes('login')) { %>
      <Stack.Screen name="login" options={{ title: 'Login' }} />
      <% } %>
      <% if (props.stylingPackage?.options?.pagePresets?.includes('signup')) { %>
      <Stack.Screen name="signup" options={{ title: 'Signup' }} />
      <% } %>
    </Stack>
<% } else if (props.stylingPackage?.name === "nativewind") { %>
    <SafeAreaProvider>
      <Stack>
        <% if (props.stylingPackage?.options?.pagePresets?.includes('settings')) { %>
        <Stack.Screen name="settings" options={{ title: 'Settings' }} />
        <% } %>
        <% if (props.stylingPackage?.options?.pagePresets?.includes('profile')) { %>
        <Stack.Screen name="profile" options={{ title: 'Profile' }} />
        <% } %>
        <% if (props.stylingPackage?.options?.pagePresets?.includes('login')) { %>
        <Stack.Screen name="login" options={{ title: 'Login' }} />
        <% } %>
        <% if (props.stylingPackage?.options?.pagePresets?.includes('signup')) { %>
        <Stack.Screen name="signup" options={{ title: 'Signup' }} />
        <% } %>
      </Stack>
    </SafeAreaProvider>
<% } else { %>
    <Stack>
      <% if (props.stylingPackage?.options?.pagePresets?.includes('settings')) { %>
      <Stack.Screen name="settings" options={{ title: 'Settings' }} />
      <% } %>
      <% if (props.stylingPackage?.options?.pagePresets?.includes('profile')) { %>
      <Stack.Screen name="profile" options={{ title: 'Profile' }} />
      <% } %>
      <% if (props.stylingPackage?.options?.pagePresets?.includes('login')) { %>
      <Stack.Screen name="login" options={{ title: 'Login' }} />
      <% } %>
      <% if (props.stylingPackage?.options?.pagePresets?.includes('signup')) { %>
      <Stack.Screen name="signup" options={{ title: 'Signup' }} />
      <% } %>
    </Stack>
<% } %>
  );
}
