<% if (props.navigationPackage?.options.type === 'stack') { %>
  import { createStaticNavigation, StaticParamList } from '@react-navigation/native';
  import { createStackNavigator } from '@react-navigation/stack';
  import Overview from '@/screens/overview';
  import Details from '@/screens/details';
  import { BackButton } from '@/components/BackButton';
  <% if (props.stylingPackage?.options?.pagePresets?.includes('settings')) { %>
  import SettingsPage from '@/components/Settings';
  <% } %>
  <% if (props.stylingPackage?.options?.pagePresets?.includes('profile')) { %>
  import ProfilePage from '@/components/Profile';
  <% } %>
  <% if (props.stylingPackage?.options?.pagePresets?.includes('login')) { %>
  import LoginPage from '@/components/Login';
  <% } %>
  <% if (props.stylingPackage?.options?.pagePresets?.includes('signup')) { %>
  import SignupPage from '@/components/Signup';
  <% } %>

  const Stack = createStackNavigator({
    screens: {
      Overview: {
        screen: Overview,
      },
      Details: {
        screen: Details,
        options: ({ navigation }) => ({
          headerLeft: () => <BackButton onPress={navigation.goBack} />,
        }),
      },
      <% if (props.stylingPackage?.options?.pagePresets?.includes('settings')) { %>
      Settings: {
        screen: SettingsPage,
        options: {
          title: 'Settings',
        },
      },
      <% } %>
      <% if (props.stylingPackage?.options?.pagePresets?.includes('profile')) { %>
      Profile: {
        screen: ProfilePage,
        options: {
          title: 'Profile',
        },
      },
      <% } %>
      <% if (props.stylingPackage?.options?.pagePresets?.includes('login')) { %>
      Login: {
        screen: LoginPage,
        options: {
          title: 'Login',
        },
      },
      <% } %>
      <% if (props.stylingPackage?.options?.pagePresets?.includes('signup')) { %>
      Signup: {
        screen: SignupPage,
        options: {
          title: 'Signup',
        },
      },
      <% } %>
    },
  });

  type RootNavigatorParamList = StaticParamList<typeof Stack>;

  declare global {
    namespace ReactNavigation {
      // eslint-disable-next-line @typescript-eslint/no-empty-object-type
      interface RootParamList extends RootNavigatorParamList {}
    }
  }

  const Navigation = createStaticNavigation(Stack);
  export default Navigation;

